{
  "name": "scribble-feedback",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "description": "A local sketchbook for visual feedback to coding agents.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "scribble": "bin/scribble.mjs"
  },
  "scripts": {
    "dev": "node bin/scribble.mjs start --dev --no-open",
    "build": "tsc -b && vite build",
    "start": "node bin/scribble.mjs start",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
